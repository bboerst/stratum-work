{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "envValueFrom": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "secretKeyRef"
        ],
        "additionalProperties": false,
        "properties": {
          "secretKeyRef": {
            "type": "object",
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "optional": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable",
          "labelSelector"
        ]
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object"
    },
    "existingSecret": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "hpa": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "cpuUtilization": {
          "type": "integer",
          "minimum": 1
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+%$"
            }
          ]
        }
      }
    }
  }
}
