# Copy to .env (gitignored) and adjust. docker compose reads it automatically.

# Origin your browser uses for the web UI. Opening it from another machine?
# e.g. CORS_ORIGINS=http://my-devbox:3000 and ALLOWED_DEV_ORIGINS=my-devbox
CORS_ORIGINS=http://localhost:3000
# Hostnames allowed to use Next.js dev resources (hot reload) when browsing from another machine
ALLOWED_DEV_ORIGINS=

# Bitcoin node used by the backend (block detection + analytics). Read-only RPC is enough.
# Nodes behind a TLS proxy (e.g. StartOS): BITCOIN_RPC_SCHEME=https and BITCOIN_RPC_CA_FILE=<host path to root CA PEM>
BITCOIN_RPC_SCHEME=http
BITCOIN_RPC_CA_FILE=
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_ZMQ_BLOCK=tcp://host.docker.internal:28332

# Lowest height the backend backfills on first start. Set near the current tip for a quick local start.
MIN_BLOCK_HEIGHT=863998

# Postgres + TimescaleDB (opt-in profile: docker compose --profile postgres up). Host port for the database.
POSTGRES_PORT=5432

# Optional: collectors ALSO write to Postgres (#111). Needs `--profile postgres`. Leave COLLECTOR_PG_HOST empty to disable.
COLLECTOR_PG_HOST=
COLLECTOR_PG_USER=collector
COLLECTOR_PG_PASSWORD=collector
# Where these collectors run (timing is only comparable within a site)
COLLECTOR_SITE=local

# Optional: backend storage (#112). mongodb (default) or postgres (needs `--profile postgres`).
BACKEND_DB_BACKEND=mongodb

# Optional: where the web app reads from (#113). mongodb (default) or postgres (needs `--profile postgres`).
# With postgres it connects as the local read-only `web` user (WEB_PG_HOST/PORT/DATABASE/USER/PASSWORD override it).
# WEB_PG_SSLMODE: disable (default) | require | verify-ca | verify-full.
WEB_DB_BACKEND=mongodb
