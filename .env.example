# Copy to .env (gitignored) and adjust. docker compose reads it automatically.

# Web UI: listen address on this machine, and the origin your browser uses.
# Remote dev box over Tailscale: WEB_BIND=0.0.0.0 and CORS_ORIGINS=http://<tailnet-name>:3000
WEB_BIND=127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Hostnames allowed to use Next.js dev resources (hot reload) when browsing from another machine
ALLOWED_DEV_ORIGINS=

# Bitcoin node used by the backend (block detection + analytics). Read-only RPC is enough.
# Nodes behind a TLS proxy (e.g. StartOS): BITCOIN_RPC_SCHEME=https and BITCOIN_RPC_CA_FILE=<host path to root CA PEM>
BITCOIN_RPC_SCHEME=http
BITCOIN_RPC_CA_FILE=
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_ZMQ_BLOCK=tcp://host.docker.internal:28332

# Lowest height the backend backfills on first start. Set near the current tip for a quick local start.
MIN_BLOCK_HEIGHT=863998
