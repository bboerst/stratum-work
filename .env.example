# Copy to .env (gitignored) and adjust. docker compose reads it automatically.

# Origin your browser uses for the web UI. Opening it from another machine?
# e.g. CORS_ORIGINS=http://my-devbox:3000 and ALLOWED_DEV_ORIGINS=my-devbox
CORS_ORIGINS=http://localhost:3000
# Hostnames allowed to use Next.js dev resources (hot reload) when browsing from another machine
ALLOWED_DEV_ORIGINS=

# Bitcoin node used by the backend (block detection + analytics). Read-only RPC is enough.
# Nodes behind a TLS proxy (e.g. StartOS): BITCOIN_RPC_SCHEME=https and BITCOIN_RPC_CA_FILE=<host path to root CA PEM>
BITCOIN_RPC_SCHEME=http
BITCOIN_RPC_CA_FILE=
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_ZMQ_BLOCK=tcp://host.docker.internal:28332

# Lowest height the backend backfills on first start. Set near the current tip for a quick local start.
MIN_BLOCK_HEIGHT=863998
# Heights below the tip checked against the node's active chain after each sync, new block and reorg: missing blocks
# are fetched, blocks a reorg replaced are swapped for the node's and marked stale (0 = off)
#BLOCK_GAP_WINDOW=144
# Every height missing between MIN_BLOCK_HEIGHT and the stored tip is fetched at startup (after the sync) and then
# every BLOCK_GAP_FILL_INTERVAL_S seconds (0 = off). On a pruned node the node first downloads the block again from a
# peer that serves old blocks (getblockfrompeer, Bitcoin Core 23+). Per run: at most BLOCK_GAP_FILL_MAX_BLOCKS blocks,
# up to BLOCK_GAP_FILL_PEERS peers per block, BLOCK_GAP_FILL_PEER_TIMEOUT_S seconds each. No gaps = no RPC.
#BLOCK_GAP_FILL_INTERVAL_S=3600
#BLOCK_GAP_FILL_MAX_BLOCKS=50
#BLOCK_GAP_FILL_PEERS=3
#BLOCK_GAP_FILL_PEER_TIMEOUT_S=30

# Postgres + TimescaleDB (opt-in profile: docker compose --profile postgres up). Host port for the database.
POSTGRES_PORT=5432

# Optional: collectors ALSO write to Postgres (#111). Needs `--profile postgres`. Leave COLLECTOR_PG_HOST empty to disable.
COLLECTOR_PG_HOST=
COLLECTOR_PG_USER=collector
COLLECTOR_PG_PASSWORD=collector
# Where these collectors run (timing is only comparable within a site)
COLLECTOR_SITE=local
# Replica identity when the same pool is collected more than once per site (redundant collection): a, b, ...
COLLECTOR_REPLICA=a

# Optional: backend storage (#112). mongodb (default) or postgres (needs `--profile postgres`).
BACKEND_DB_BACKEND=mongodb

# Optional: where the web app reads from (#113). mongodb (default) or postgres (needs `--profile postgres`).
# With postgres it connects as the local read-only `web` user (WEB_PG_HOST/PORT/DATABASE/USER/PASSWORD override it).
# WEB_PG_SSLMODE: disable (default) | require | verify-ca | verify-full.
WEB_DB_BACKEND=mongodb

# Optional: live display limit per pool (#105). A pool sending templates faster than STREAM_POOL_RATE per second
# (after STREAM_POOL_BURST at once) has only its newest template forwarded to browsers, plus a "burst" marker; every
# template is still stored. 0 disables. Defaults: 5 and 20 (normal traffic is never affected).
# STREAM_POOL_RATE=5
# STREAM_POOL_BURST=20

# Optional (set it in production): key for masking extranonce1 in everything the web serves (#105). extranonce1 is
# assigned per connection, so it identifies the collector's session to the pool; the web replaces it with an
# HMAC-SHA256 pseudonym of the same length (the database keeps the real value). Without a key, a random one is made
# at startup, so pseudonyms change on every restart and differ between replicas. Generate with `openssl rand -hex 32`.
# Server-side only: never expose it as NEXT_PUBLIC_*.
# EXTRANONCE1_MASK_KEY=

# Optional: where the realtime table gets each template's first-transaction fee rate (#198). auto (default): this
# deployment's /api/tx (the mempool recorder's data) when WEB_DB_BACKEND=postgres, else mempool.space (the browser asks
# it directly, as before). local | mempool.space force one. TX_API_MEMPOOL_SPACE_FALLBACK=true asks mempool.space when
# /api/tx fails (default false).
# TX_API_SOURCE=auto
# TX_API_MEMPOOL_SPACE_FALLBACK=false
